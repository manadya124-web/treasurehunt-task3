diff --git a/lib/postAuthRedirect.ts b/lib/postAuthRedirect.ts
new file mode 100644
index 0000000..7a2f71f
--- /dev/null
+++ b/lib/postAuthRedirect.ts
@@ -0,0 +1,54 @@
+// Helpers for "send the user back where they were going after login/signup/verify".
+//
+// The destination travels in a `?next=` query parameter (the Treasure Hunt game
+// page already uses this convention). Anything coming from the URL is untrusted,
+// so every value goes through getSafeRedirectPath() before we navigate to it.
+
+const PLACEHOLDER_ORIGIN = "http://placeholder.invalid";
+
+// Auth pages themselves are never valid destinations (prevents redirect loops).
+const AUTH_PATHS = ["/auth/login", "/auth/signup", "/auth/verify-email"];
+
+/**
+ * Returns a safe, same-site path (with query/hash preserved), or null if the
+ * value is missing, external, or malformed.
+ */
+export function getSafeRedirectPath(raw: string | null | undefined): string | null {
+  if (typeof raw !== "string") return null;
+  const value = raw.trim();
+  if (!value || value.length > 2048) return null;
+
+  // Must be an absolute path on this site: "/something". Rejects "https://evil.com",
+  // "evil.com", "javascript:..." and protocol-relative "//evil.com".
+  if (!value.startsWith("/") || value.startsWith("//")) return null;
+
+  // Reject backslashes (browsers treat "/\evil.com" like "//evil.com"),
+  // whitespace and control characters.
+  if (/[\\\s\u0000-\u001f\u007f]/.test(value)) return null;
+
+  let url: URL;
+  try {
+    url = new URL(value, PLACEHOLDER_ORIGIN);
+  } catch {
+    return null;
+  }
+  if (url.origin !== PLACEHOLDER_ORIGIN) return null;
+
+  if (AUTH_PATHS.some((p) => url.pathname === p || url.pathname.startsWith(p + "/"))) {
+    return null;
+  }
+
+  return url.pathname + url.search + url.hash;
+}
+
+/** Reads and validates ?next= from the current browser URL. Client-side only. */
+export function readNextFromLocation(): string | null {
+  if (typeof window === "undefined") return null;
+  return getSafeRedirectPath(new URLSearchParams(window.location.search).get("next"));
+}
+
+/** "/auth/login" + (optional) next -> "/auth/login?next=%2Fevents%2Ftreasurehunt" */
+export function withNext(path: string, next: string | null | undefined): string {
+  const safe = getSafeRedirectPath(next);
+  return safe ? `${path}?next=${encodeURIComponent(safe)}` : path;
+}
diff --git a/tests/postAuthRedirect.test.mjs b/tests/postAuthRedirect.test.mjs
new file mode 100644
index 0000000..3d458c8
--- /dev/null
+++ b/tests/postAuthRedirect.test.mjs
@@ -0,0 +1,43 @@
+// Run with:  node --experimental-strip-types --test tests/
+import test from "node:test";
+import assert from "node:assert/strict";
+import { getSafeRedirectPath, withNext } from "../lib/postAuthRedirect.ts";
+
+test("accepts valid internal paths and keeps query/hash", () => {
+  assert.equal(getSafeRedirectPath("/events/treasurehunt"), "/events/treasurehunt");
+  assert.equal(getSafeRedirectPath("/events/treasurehunt/game?teamId=abc"), "/events/treasurehunt/game?teamId=abc");
+  assert.equal(getSafeRedirectPath("/a?x=1#frag"), "/a?x=1#frag");
+  assert.equal(getSafeRedirectPath("/"), "/");
+});
+
+test("rejects missing values", () => {
+  for (const v of [null, undefined, "", "   "]) assert.equal(getSafeRedirectPath(v), null);
+});
+
+test("rejects external / protocol-relative / scheme URLs", () => {
+  for (const v of [
+    "https://evil.com", "http://evil.com/x", "//evil.com", "///evil.com",
+    "evil.com", "javascript:alert(1)", "data:text/html,hi", "events/treasurehunt",
+  ]) assert.equal(getSafeRedirectPath(v), null, v);
+});
+
+test("rejects backslash, whitespace and control-char tricks", () => {
+  for (const v of ["/\\evil.com", "\\\\evil.com", "/\\/evil.com", "/\t/evil.com", "/\n/evil.com", "/a b", "/a\u0000b"])
+    assert.equal(getSafeRedirectPath(v), null, JSON.stringify(v));
+});
+
+test("rejects auth pages (prevents redirect loops)", () => {
+  for (const v of ["/auth/login", "/auth/login?next=%2Fx", "/auth/signup", "/auth/verify-email"])
+    assert.equal(getSafeRedirectPath(v), null, v);
+  assert.equal(getSafeRedirectPath("/auth/forgot-password"), "/auth/forgot-password");
+});
+
+test("rejects overly long input", () => {
+  assert.equal(getSafeRedirectPath("/" + "a".repeat(3000)), null);
+});
+
+test("withNext only appends safe destinations", () => {
+  assert.equal(withNext("/auth/login", "/events/treasurehunt"), "/auth/login?next=%2Fevents%2Ftreasurehunt");
+  assert.equal(withNext("/auth/login", "https://evil.com"), "/auth/login");
+  assert.equal(withNext("/auth/signup", null), "/auth/signup");
+});
